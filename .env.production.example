# Configuración de producción. Cópialo a `.env.production` en el servidor y rellénalo.
# `.env.production` está en .gitignore: nunca lo subas al repositorio.
#
#   cp .env.production.example .env.production
#   chmod 600 .env.production
#
# Antes de desplegar, comprueba que no queda ningún marcador:
#   set -a; . ./.env.production; set +a; pnpm preflight

# --- Base de datos -----------------------------------------------------------------
POSTGRES_USER=invite
POSTGRES_DB=invite
# Genérala, no la inventes:  openssl rand -base64 24
# Cambiarla después obliga a recrear el volumen: la base solo la lee al inicializarse.
POSTGRES_PASSWORD=

# --- Dominio -----------------------------------------------------------------------
# El DNS de este dominio debe apuntar al servidor ANTES de levantar Caddy: pide el
# certificado en el arranque y un dominio sin resolver consume intentos contra el
# límite de Let's Encrypt.
SITE_DOMAIN=
# El mismo dominio con https://, sin barra final. Define canonical, sitemap, los
# enlaces de invitado y la URL del enlace de cliente.
SITE_URL=
