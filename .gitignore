# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
.next
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files (can opt-in for committing if needed)
.env
.env.local
# Lleva la contraseña de Postgres de producción. El .example sí se versiona.
.env.production
!.env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# app-specific
storage/

# process scaffolding, not part of the shipped project
.superpowers/

# Playwright
/test-results
/playwright-report

# pnpm store local
/.pnpm-store

# Cookie de sesión que genera el setup de Playwright
tests/e2e/.auth

# Service Worker generado por Serwist en cada build. Versionarlo dejaría a la puerta
# sirviendo el JS del último commit en vez del de la imagen desplegada.
/public/sw.js
/public/sw.js.map
.audit/
